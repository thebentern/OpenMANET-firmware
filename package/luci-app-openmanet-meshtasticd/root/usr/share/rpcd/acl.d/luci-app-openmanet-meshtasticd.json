{
	"luci-app-openmanet-meshtasticd": {
		"description": "Grant access to the AXT-1800 meshtasticd configuration page",
		"read": {
			"file": {
				"/etc/meshtasticd": [ "list" ],
				"/etc/meshtasticd/available.d": [ "list" ],
				"/etc/meshtasticd/available.d/*": [ "read" ],
				"/etc/meshtasticd/config.d": [ "list" ],
				"/etc/meshtasticd/config.d/*": [ "read" ],
				"/etc/meshtasticd/config.yaml": [ "read" ],
				"/sys/class/net": [ "list" ],
				"/usr/bin/apk info -e meshtasticd": [ "exec" ],
				"/usr/bin/apk info meshtasticd": [ "exec" ],
				"/etc/init.d/meshtasticd enabled": [ "exec" ],
				"/usr/bin/pidof meshtasticd": [ "exec" ],
				"/sbin/logread": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/etc/init.d/meshtasticd start": [ "exec" ],
				"/etc/init.d/meshtasticd stop": [ "exec" ],
				"/etc/init.d/meshtasticd restart": [ "exec" ],
				"/etc/init.d/meshtasticd enable": [ "exec" ],
				"/etc/init.d/meshtasticd disable": [ "exec" ],
				"/etc/meshtasticd/config.d/*.yaml": [ "write" ]
			}
		}
	}
}
