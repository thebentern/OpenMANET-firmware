{
	"luci-app-axt1800-camera": {
		"description": "Grant access to the AXT-1800 camera RTSP setup page",
		"read": {
			"uci": [ "v4l2rtspserver" ],
			"file": {
				"/usr/bin/v4l2-ctl --list-devices": [ "exec" ],
				"/usr/bin/v4l2-ctl --device=*": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "v4l2rtspserver" ]
		}
	}
}
