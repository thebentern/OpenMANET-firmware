{%
//
// AXT-1800 Tailscale dashboard, server-side rendered.
//
// Surfaces tailscale state in a LuCI page so operators don't have to SSH
// just to check tunnel status or kick a login. The headline use case is
// "bridge the local mesh to a remote command center via a phone hotspot" —
// for that, the most important affordance is the login-QR flow: scan on
// phone, sign into the Tailnet, peer is added.
//
// Data sources:
//   - `tailscale status --json`         — full state (parsed via ucode json())
//   - `tailscale ip -4`                 — Tailnet IPv4 quick read
//   - `pidof tailscaled`                — daemon-up check
//   - /tmp/ts-login.log                 — stdout from a backgrounded
//                                          `tailscale up`, used to harvest
//                                          the AuthURL during NeedsLogin
//
// POST actions:
//   action=login         backgrounded `tailscale up &` → AuthURL surfaces
//   action=down          `tailscale down`              → backend Stopped
//   action=logout        `tailscale logout`            → forget keys
//   action=advertise     `tailscale up --advertise-routes=...`
//   action=exit-node     `tailscale up --advertise-exit-node`
//

import { popen, readfile, unlink } from 'fs';

const LOGIN_LOG = '/tmp/ts-login.log';

// --- helpers ---------------------------------------------------------------

function slurp(cmd) {
	let fp = popen(cmd, 'r');
	if (!fp) return '';
	let out = fp.read('all') || '';
	fp.close();
	return trim(out);
}

function tailscale_installed() {
	return slurp('which tailscale') != '';
}

// `tailscale status --json` returns a fully-formed StatusInfo blob even when
// the daemon is logged out (BackendState=NeedsLogin). When the daemon is
// stopped entirely, exit code is non-zero — we still get reasonable defaults.
function tailscale_status() {
	let raw = slurp('tailscale status --json 2>/dev/null');
	if (raw == '') return null;
	try {
		return json(raw);
	} catch (e) {
		return null;
	}
}

// Best-effort extract an AuthURL from a backgrounded `tailscale up` run.
// tailscale prints the URL on stdout; we capture to LOGIN_LOG. The first
// post-action page-load may not see it yet (race) — the user just clicks
// Refresh and it shows up.
function pending_auth_url() {
	let txt = readfile(LOGIN_LOG);
	if (!txt) return '';
	let m = match(txt, /(https?:\/\/login\.tailscale\.com\/[^\s"]+)/);
	return m ? m[1] : '';
}

function ts_pid() {
	let p = slurp('pidof tailscaled');
	return p != '' ? p : '';
}

// Best-effort shell-escape for a value that we're about to splice into a
// `tailscale up --flag="$VALUE"` invocation. The form fields are all
// constrained / validated upstream of this so the surface is small, but
// belt-and-suspenders: reject anything outside a strict character set.
function sanitize_token(s, pattern) {
	if (s == null || s == '') return '';
	if (!match(s, pattern)) return '';
	return s;
}

// --- POST handler ----------------------------------------------------------
let posted = http.getenv('REQUEST_METHOD') == 'POST';
let msg = null;
const installed = tailscale_installed();

if (posted && installed) {
	let action = http.formvalue('action') || '';

	if (action == 'login_interactive') {
		// Kick off a fresh interactive login. Background it so the page
		// returns quickly. We pipe stdout+stderr to LOGIN_LOG; subsequent
		// renders harvest the AuthURL from there.
		unlink(LOGIN_LOG);
		slurp('(/usr/sbin/tailscale up --reset > ' + LOGIN_LOG + ' 2>&1 &)');
		slurp('sleep 1');
		msg = 'Interactive login started. Scan the QR code or open the link below.';
	}
	else if (action == 'down') {
		slurp('/usr/sbin/tailscale down 2>&1');
		msg = 'Tailscale brought down. Re-Apply or Login to bring it back up.';
	}
	else if (action == 'logout') {
		slurp('/usr/sbin/tailscale logout 2>&1');
		unlink(LOGIN_LOG);
		msg = 'Logged out. The node identity has been forgotten on this Tailnet.';
	}
	else if (action == 'apply') {
		// Unified settings-apply. tailscale up is stateful — every invocation
		// specifies the COMPLETE desired state; omitted flags revert to
		// defaults. So we always re-pass every flag from the form on save,
		// even if the operator only changed one thing.
		let auth_key  = sanitize_token(http.formvalue('auth_key'),    /^[A-Za-z0-9_\-]{12,}$/);
		let hostname  = sanitize_token(http.formvalue('hostname'),    /^[A-Za-z0-9._\-]+$/);
		let tags      = sanitize_token(http.formvalue('tags'),        /^[A-Za-z0-9_\-:,]+$/);
		let routes    = sanitize_token(http.formvalue('routes'),      /^[\d\/\.,]+$/);
		let exit_node = http.formvalue('exit_node') == '1';
		let ssh       = http.formvalue('ssh')       == '1';

		// Build the command. Order doesn't matter to tailscale, but we
		// group flags by what they mean for readability in logs.
		let args = [];
		if (auth_key != '') push(args, '--authkey="' + auth_key + '"');
		if (hostname != '') push(args, '--hostname="' + hostname + '"');
		if (tags     != '') push(args, '--advertise-tags="' + tags + '"');
		push(args, '--advertise-routes="' + routes + '"');
		push(args, exit_node ? '--advertise-exit-node' : '--advertise-exit-node=false');
		push(args, ssh ? '--ssh' : '--ssh=false');

		// tailscale up blocks on interactive auth when --authkey isn't given
		// AND state is logged-out. We background it the same way as the
		// interactive login flow so the page returns fast either way.
		unlink(LOGIN_LOG);
		let cmd = '(/usr/sbin/tailscale up ' + join(' ', args) + ' > ' + LOGIN_LOG + ' 2>&1 &)';
		slurp(cmd);
		slurp('sleep 1');

		msg = auth_key != ''
			? 'Settings applied with auth key — should come up Running shortly. Click Refresh.'
			: 'Settings applied. If backend is still NeedsLogin, scan the QR / open the link below.';
	}
}

// --- gather state ----------------------------------------------------------
const st          = installed ? tailscale_status() : null;
const backend     = st ? st.BackendState : 'Unknown';
const self        = st ? st.Self : null;
const peers_dict  = st && st.Peer ? st.Peer : {};
const tailnet     = st && st.CurrentTailnet ? st.CurrentTailnet.Name : '';
const auth_url    = (st && st.AuthURL) ? st.AuthURL : pending_auth_url();
const ts4         = (self && self.TailscaleIPs && length(self.TailscaleIPs) > 0)
                    ? self.TailscaleIPs[0] : '';
const cur_hostname    = self ? (self.HostName || '') : '';
const cur_tags        = (self && self.Tags) ? join(',', self.Tags) : '';
const adv_routes_csv    = (self && self.AdvertisedRoutes) ? join(',', self.AdvertisedRoutes) : '';
const adv_routes_pretty = (self && self.AdvertisedRoutes) ? join(', ', self.AdvertisedRoutes) : '';
const is_exit_node = self ? !!self.ExitNodeOption : false;
const pid         = installed ? ts_pid() : '';

// Stable peer list (dict → array, sorted by HostName)
let peers = [];
if (peers_dict) {
	for (let k in peers_dict) {
		let p = peers_dict[k];
		push(peers, p);
	}
	peers = sort(peers, function(a, b) {
		return (a.HostName || '') < (b.HostName || '') ? -1 : 1;
	});
}

// Backend → pill colour
function backend_pill(state) {
	if (state == 'Running')         return 'ts-pill-on';
	if (state == 'NeedsLogin')      return 'ts-pill-warn';
	if (state == 'NeedsMachineAuth')return 'ts-pill-warn';
	return 'ts-pill-off';
}

include('header');
%}

<style>
	.ts-card       { background:#1c1c1c; border-radius:8px; padding:14px; margin-bottom:1em; }
	.ts-pill       { display:inline-block; padding:2px 10px; border-radius:11px; font-size:11px;
	                  font-weight:600; letter-spacing:0.5px; }
	.ts-pill-on    { background:#2d6a4f; color:#fff; }
	.ts-pill-warn  { background:#bf6900; color:#fff; }
	.ts-pill-off   { background:#444;    color:#bbb; }
	.ts-grid       { display:grid; grid-template-columns:auto 1fr; gap:6px 14px; font-size:13px; }
	.ts-grid dt    { color:#bbb; }
	.ts-grid dd    { color:#fff; font-family:Menlo,Consolas,monospace; font-size:12.5px; margin:0; }
	.ts-tbl th     { text-align:left; padding:6px 8px; background:#222; color:#bbb; font-size:11.5px;
	                  font-weight:600; letter-spacing:0.5px; }
	.ts-tbl td     { padding:6px 8px; font-family:Menlo,Consolas,monospace; font-size:12px; }
	.ts-tbl tr+tr td { border-top:1px solid #2a2a2a; }
	.ts-auth-card  { background:#1c1c1c; border-radius:8px; padding:16px; display:flex; gap:20px; align-items:center; }
	.ts-empty      { color:#888; font-style:italic; padding:18px; text-align:center; }
	.ts-online     { color:#7cd07c; }
	.ts-offline    { color:#888; }
	.ts-self       { background:#1a2a1a; }
	.ts-btns       { display:flex; gap:6px; flex-wrap:wrap; }
</style>

<div class="cbi-map">
	<h2 name="content">{{ _('Tailscale') }}</h2>
	<div class="cbi-map-descr">
		{{ _('Tailscale tunnel state — sign in, see your Tailnet peers, advertise the LAN subnet, act as an exit node. The headline operator workflow is the login-QR card below: scan with a phone, sign in, this router joins the Tailnet. Detailed admin (ACLs, MagicDNS, etc.) lives in the Tailscale web console.') }}
		<form method="GET" action="" style="display:inline-block;margin-left:1em;">
			<button type="submit" class="cbi-button">{{ _('Refresh') }}</button>
		</form>
	</div>

	{% if (msg): %}
	<div class="alert-message notice" style="background:#2d6a4f;color:#fff;padding:10px;border-radius:6px;margin:1em 0;">{{ msg }}</div>
	{% endif %}

	{% if (!installed): %}
	<fieldset class="cbi-section">
		<legend>{{ _('Tailscale not installed') }}</legend>
		<div class="ts-card">
			<p>{{ _('The `tailscale` binary is not in this image. Install it via:') }}</p>
			<pre style="background:#0f0f0f;padding:10px;border-radius:6px;color:#ddd;">apk update &amp;&amp; apk add tailscale</pre>
		</div>
	</fieldset>
	{% endif %}

	{% if (installed): %}

	<!-- ============================================================ -->
	<!-- Section 1: Status                                              -->
	<!-- ============================================================ -->
	<fieldset class="cbi-section">
		<legend>{{ _('Status') }}</legend>
		<div class="ts-card">
			<div style="margin-bottom:10px;">
				<strong>{{ _('Backend:') }}</strong>
				<span class="ts-pill {{ backend_pill(backend) }}">{{ backend }}</span>
				{% if (pid): %}<span class="ts-pill ts-pill-on" style="margin-left:6px;">daemon PID {{ pid }}</span>{% endif %}
				{% if (!pid): %}<span class="ts-pill ts-pill-off" style="margin-left:6px;">daemon stopped</span>{% endif %}
			</div>
			<dl class="ts-grid">
				<dt>{{ _('Hostname') }}</dt>      <dd>{{ cur_hostname || '—' }}</dd>
				<dt>{{ _('Tailnet IPv4') }}</dt>  <dd>{{ ts4 || '—' }}</dd>
				<dt>{{ _('Tailnet') }}</dt>       <dd>{{ tailnet || '—' }}</dd>
				<dt>{{ _('Tags') }}</dt>          <dd>{{ cur_tags || '—' }}</dd>
				<dt>{{ _('Advertised routes') }}</dt> <dd>{{ adv_routes_pretty || '—' }}</dd>
				<dt>{{ _('Exit node') }}</dt>     <dd>{{ is_exit_node ? _('Advertising') : _('No') }}</dd>
			</dl>

			<form method="POST" action="" class="ts-btns" style="margin-top:12px;">
				{% if (backend == 'NeedsLogin' || backend == 'Stopped'): %}
					<button type="submit" class="cbi-button" name="action" value="login_interactive">{{ _('Interactive login (no auth key)') }}</button>
					<div style="color:#888;font-size:11px;margin-top:4px;">
						{{ _('Use the Setup form below for non-interactive enrollment via a pre-auth key.') }}
					</div>
				{% endif %}
				{% if (backend == 'Running'): %}
					<button type="submit" class="cbi-button" name="action" value="down">{{ _('Bring down') }}</button>
					<button type="submit" class="cbi-button" name="action" value="logout">{{ _('Logout (forget identity)') }}</button>
				{% endif %}
			</form>
		</div>
	</fieldset>

	<!-- ============================================================ -->
	<!-- Section 2: Setup (auth + identity + routes + ssh)              -->
	<!-- Single Apply button re-passes all flags to `tailscale up`      -->
	<!-- ============================================================ -->
	<fieldset class="cbi-section">
		<legend>{{ _('Setup') }}</legend>
		<div class="cbi-section-descr">
			{{ _('Bootstrap this router onto your Tailnet (non-interactive via a pre-auth key) or tune settings on an already-authed daemon. Every Apply re-passes the full set of flags to `tailscale up` — that\'s the only safe way to keep settings sticky, because tailscale resets omitted flags to defaults. Read the README\'s \"Tailscale fleet setup\" section for the end-to-end team workflow.') }}
		</div>
		<form method="POST" action="">
		<input type="hidden" name="action" value="apply">
		<div class="cbi-section-node">

			<div class="cbi-value">
				<label class="cbi-value-title" for="cbi-ts-auth-key">{{ _('Pre-auth key') }}</label>
				<div class="cbi-value-field">
					<input class="cbi-input-password" id="cbi-ts-auth-key" type="password" name="auth_key"
						value="" placeholder="tskey-auth-…" style="width:100%;max-width:480px;font-family:Menlo,Consolas,monospace;">
					<div class="cbi-value-description">
						{{ _('Generate in Tailscale admin console → Settings → Keys. Recommended flags: Reusable, Pre-authorized, Tags = tag:your-router-tag. Leave blank to use the existing identity (already-authed routers just need this on first enrollment).') }}
					</div>
				</div>
			</div>

			<div class="cbi-value">
				<label class="cbi-value-title" for="cbi-ts-hostname">{{ _('Hostname') }}</label>
				<div class="cbi-value-field">
					<input class="cbi-input-text" id="cbi-ts-hostname" type="text" name="hostname"
						value="{{ cur_hostname }}" placeholder="axt-eagle-1" maxlength="63">
					<div class="cbi-value-description">{{ _('How this router shows in the Tailscale admin console. Default is the system hostname (often "OpenWrt", useless across a fleet). Pick something operator-readable.') }}</div>
				</div>
			</div>

			<div class="cbi-value">
				<label class="cbi-value-title" for="cbi-ts-tags">{{ _('Advertise tags') }}</label>
				<div class="cbi-value-field">
					<input class="cbi-input-text" id="cbi-ts-tags" type="text" name="tags"
						value="{{ cur_tags }}" placeholder="tag:axt-router">
					<div class="cbi-value-description">{{ _('Comma-separated, each must start with "tag:". The auth key\'s tagOwners ACL must allow these tags. Ties this device to ACL rules in the admin console (e.g. "tag:axt-router can be reached by group:operators").') }}</div>
				</div>
			</div>

			<div class="cbi-value">
				<label class="cbi-value-title" for="cbi-ts-routes">{{ _('Advertise routes') }}</label>
				<div class="cbi-value-field">
					<input class="cbi-input-text" id="cbi-ts-routes" type="text" name="routes"
						value="{{ adv_routes_csv }}" placeholder="192.168.1.0/24,10.41.0.0/16">
					<div class="cbi-value-description">{{ _('Comma-separated CIDRs (no spaces). Typical: LAN subnet + mesh L3 subnet. Tailnet peers can then reach LAN/mesh services through this router. Admin must approve routes once in the admin console.') }}</div>
				</div>
			</div>

			<div class="cbi-value">
				<label class="cbi-value-title" for="cbi-ts-exit">{{ _('Act as exit node') }}</label>
				<div class="cbi-value-field">
					<input class="cbi-input-checkbox" id="cbi-ts-exit" type="checkbox" name="exit_node" value="1"{{ is_exit_node ? ' checked' : '' }}>
					<div class="cbi-value-description">{{ _('Other Tailnet peers can route all their internet traffic through this router\'s WAN. Useful when this router is the only one with a hotspot — remote ops route via your phone hotspot. Admin approval required.') }}</div>
				</div>
			</div>

			<div class="cbi-value">
				<label class="cbi-value-title" for="cbi-ts-ssh">{{ _('Tailscale SSH server') }}</label>
				<div class="cbi-value-field">
					<input class="cbi-input-checkbox" id="cbi-ts-ssh" type="checkbox" name="ssh" value="1">
					<div class="cbi-value-description">{{ _('Enable the built-in `tailscale ssh` server. ACL-controlled access without distributing SSH keys — Tailscale identity gates the session. Coexists with dropbear (the regular SSH) on this router. Recommended for fleet ops.') }}</div>
				</div>
			</div>

			<div style="margin-top:12px;">
				<button type="submit" class="cbi-button cbi-button-save">{{ _('Apply') }}</button>
				<span style="margin-left:1em;color:#bbb;font-size:12px;">{{ _('Re-passes ALL flags to `tailscale up` — the only safe pattern.') }}</span>
			</div>
		</div>
		</form>
	</fieldset>

	<!-- ============================================================ -->
	<!-- Section 3: Login flow (only when needed)                       -->
	<!-- ============================================================ -->
	{% if (backend == 'NeedsLogin' && auth_url): %}
	<fieldset class="cbi-section">
		<legend>{{ _('Sign in to your Tailnet') }}</legend>
		<div class="cbi-section-descr">
			{{ _('Scan with a phone, or click the link to open in this browser. After signing in, click Refresh — the status pill should flip to Running.') }}
		</div>
		<div class="cbi-section-node">
			<div class="ts-auth-card">
				<canvas id="ts-auth-qr" width="200" height="200" style="background:#fff;border-radius:4px;"></canvas>
				<div style="flex:1;">
					<a href="{{ auth_url }}" target="_blank"
					   class="cbi-button cbi-button-action" style="display:inline-block;">
						{{ _('Open sign-in page') }}
					</a>
					<div id="ts-auth-url" style="font-family:Menlo,Consolas,monospace;font-size:11px;color:#aaa;
					            margin-top:10px;word-break:break-all;">{{ auth_url }}</div>
					<form method="GET" action="" style="margin-top:14px;">
						<button type="submit" class="cbi-button">{{ _("I've signed in — refresh") }}</button>
					</form>
				</div>
			</div>
		</div>
	</fieldset>
	{% endif %}

	{% if (backend == 'NeedsLogin' && !auth_url): %}
	<fieldset class="cbi-section">
		<legend>{{ _('Sign in to your Tailnet') }}</legend>
		<div class="ts-card">
			<p>{{ _('No auth URL pending. Click Login above to kick off a fresh sign-in flow.') }}</p>
		</div>
	</fieldset>
	{% endif %}

	<!-- ============================================================ -->
	<!-- Section 4: Peers                                               -->
	<!-- ============================================================ -->
	{% if (backend == 'Running'): %}
	<fieldset class="cbi-section">
		<legend>{{ _('Tailnet peers') }}</legend>
		<div class="cbi-section-descr">
			{{ _('Every node on this Tailnet. "Online" = had a handshake recently. Tap a peer\'s IP into your client/SSH/RTSP URL to reach it through the tunnel.') }}
		</div>
		<div class="cbi-section-node">
			{% if (length(peers) == 0): %}
				<div class="ts-empty">{{ _('No peers visible yet. Either you are the only node on this Tailnet, or DERP hasn\'t finished discovery.') }}</div>
			{% endif %}
			{% if (length(peers) > 0): %}
				<table class="ts-tbl" style="width:100%;">
					<thead>
						<tr>
							<th>{{ _('Hostname') }}</th>
							<th>{{ _('OS') }}</th>
							<th>{{ _('Tailnet IP') }}</th>
							<th>{{ _('Online') }}</th>
							<th>{{ _('Last seen') }}</th>
						</tr>
					</thead>
					<tbody>
					{% if (self): %}
						<tr class="ts-self">
							<td><strong>{{ self.HostName }} ({{ _('this node') }})</strong></td>
							<td>{{ self.OS }}</td>
							<td>{{ ts4 }}</td>
							<td class="ts-online">●</td>
							<td>—</td>
						</tr>
					{% endif %}
					{% for (p in peers): %}
						<tr>
							<td>{{ p.HostName || '—' }}</td>
							<td>{{ p.OS || '—' }}</td>
							<td>{{ (p.TailscaleIPs && length(p.TailscaleIPs) > 0) ? p.TailscaleIPs[0] : '—' }}</td>
							<td class="{{ p.Online ? 'ts-online' : 'ts-offline' }}">{% if (p.Online): %}●{% endif %}{% if (!p.Online): %}○{% endif %}</td>
							<td>{{ p.LastSeen || '—' }}</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			{% endif %}
		</div>
	</fieldset>

	{% endif %}

	{% endif %}{# /installed #}
</div>

{% if (backend == 'NeedsLogin' && auth_url): %}
<script src="/luci-static/resources/axt1800-camera/qrious.min.js"></script>
<script>
(function() {
	var canvas = document.getElementById('ts-auth-qr');
	var urlEl  = document.getElementById('ts-auth-url');
	if (canvas && urlEl && typeof QRious !== 'undefined') {
		new QRious({
			element: canvas,
			value: urlEl.textContent.trim(),
			size: 200,
			level: 'M',
			foreground: '#000',
			background: '#fff'
		});
	}
})();
</script>
{% endif %}

{% include('footer'); %}
