#!/bin/sh
#
# /etc/uci-defaults/97-meshtastic-install
#
# Best-effort first-boot install of meshtasticd + companions from
# https://openwrt.meshtastic.org. Repo config + signing key are
# already in place (shipped by the meshtastic-repo package).
#
# Behavior:
#   - Try `apk update && apk add ...`
#   - On success: enable + start the meshtasticd service, exit 0.
#     uci-defaults runner deletes this script after exit 0.
#   - On failure (e.g. no internet at boot): exit non-zero so the
#     uci-defaults runner LEAVES the script in place, and it retries
#     on the next boot.
#
# Operators with no internet can ignore this entirely and install
# manually later via `apk update && apk add meshtasticd …`.

PKGS="meshtasticd meshtasticd-web meshtasticd-avahi-service python3-meshtastic"
LOG_TAG="meshtastic-install"

# Don't fail the boot just because there's no internet — we'll just
# retry later. Use logger so progress shows up in `logread`.
log() { logger -t "$LOG_TAG" -- "$@"; }

log "starting (attempt $(date '+%H:%M:%S'))"

if ! apk update 2>&1 | logger -t "$LOG_TAG"; then
	log "apk update failed (no internet?). Will retry on next boot."
	exit 1
fi

if apk add $PKGS 2>&1 | logger -t "$LOG_TAG"; then
	log "all packages installed"
	# Make sure the daemon starts now AND at every boot from here on.
	if [ -x /etc/init.d/meshtasticd ]; then
		/etc/init.d/meshtasticd enable 2>&1 | logger -t "$LOG_TAG" || true
		/etc/init.d/meshtasticd start  2>&1 | logger -t "$LOG_TAG" || true
	fi
	exit 0
fi

log "apk add failed. Will retry on next boot."
exit 1
