#!/bin/sh
#
# /etc/uci-defaults/97-meshtastic-install
#
# Best-effort first-boot install of meshtasticd + companions from
# https://openwrt.meshtastic.org. Repo config + signing key are
# already in place (shipped by the meshtastic-repo package).
#
# Behavior:
#   - Try `apk update && apk add ...`
#   - On success AND meshtasticd verified installed: enable + start the
#     daemon, exit 0. The uci-defaults runner deletes this script after
#     exit 0.
#   - On any failure (no internet, package gone, signature mismatch,
#     etc.): exit non-zero so the uci-defaults runner LEAVES the script
#     in place, and it retries on the next boot.
#
# Operators with no internet at boot can ignore this entirely and
# install manually later via the same one-liner:
#   apk update && apk add meshtasticd meshtasticd-web \
#       meshtasticd-avahi-service python3-meshtastic
#
# IMPORTANT: do NOT use `cmd | logger` to check command status. A
# pipeline's exit status is the LAST command's, so `logger`'s zero
# masks any real failure upstream. Capture to a tempfile, check $?
# explicitly, then drain the file through logger separately.

PKGS="meshtasticd meshtasticd-web meshtasticd-avahi-service python3-meshtastic"
LOG_TAG="meshtastic-install"
TMP="$(mktemp -t meshtastic-install.XXXXXX 2>/dev/null || echo /tmp/meshtastic-install.$$.log)"

log() { logger -t "$LOG_TAG" -- "$@"; }

# Drain a captured tempfile through logger line-by-line. Critically,
# this is NOT in a pipeline with apk, so we never lose apk's exit code.
emit() {
	[ -s "$TMP" ] || return 0
	while IFS= read -r line; do
		logger -t "$LOG_TAG" -- "$line"
	done < "$TMP"
}

cleanup() { rm -f "$TMP"; }
trap cleanup EXIT

log "starting (attempt $(date '+%Y-%m-%d %H:%M:%S'))"

# --- apk update ------------------------------------------------------------
# Don't gate the rest of the script on apk update's exit code. apk-tools v3
# returns:
#   0 — all repos reachable
#   1 — partial failure (some repos reachable, some not)
#   9 — total failure (no repos reachable at all)
# A single broken / 404 repo entry in distfeeds.list (we ship an openmanet
# placeholder that 404s on downloads.openwrt.org, for example) forces exit
# 1 even when the meshtastic repo we actually need IS reachable. The
# `apk info -e meshtasticd` check below is the real verifier — if the
# daemon package actually landed, the network was good enough.
apk update > "$TMP" 2>&1
rc=$?
emit
log "apk update finished (exit $rc — proceeding to apk add regardless)"

# --- apk add ---------------------------------------------------------------
apk add $PKGS > "$TMP" 2>&1
rc=$?
emit
if [ "$rc" -ne 0 ]; then
	log "apk add failed (exit $rc). Will retry on next boot."
	exit 1
fi

# Belt-and-suspenders: even if apk add returns 0, verify the daemon
# package actually landed on disk. Catches the "all repos unreachable
# but apk add still exited 0 from cache" edge case.
if ! apk info -e meshtasticd > /dev/null 2>&1; then
	log "apk add returned 0 but meshtasticd is not installed. Will retry on next boot."
	exit 1
fi

# --- enable + start --------------------------------------------------------
log "all packages installed; enabling + starting meshtasticd"
if [ -x /etc/init.d/meshtasticd ]; then
	/etc/init.d/meshtasticd enable > "$TMP" 2>&1 || true
	emit
	/etc/init.d/meshtasticd start  > "$TMP" 2>&1 || true
	emit
fi

exit 0
