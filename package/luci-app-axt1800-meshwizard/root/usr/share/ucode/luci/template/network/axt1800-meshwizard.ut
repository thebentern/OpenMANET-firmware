{%
//
// AXT-1800 OpenMANET mesh setup wizard, server-side rendered.
//
// Pure ucode template, no JS view. The "type": "view" path involves
// LuCI's client-side runtime calling ui.instantiateView(...) which has
// somehow tickled a deterministic brick on AXT-1800 + OpenMANET 24.10
// (6.6 kernel + ipq60xx backported from upstream main). Avoiding that
// code path entirely by rendering HTML server-side here.
//

import { cursor } from 'uci';
import { popen } from 'fs';

const uci = cursor();

// --- Detect the 5 GHz wifi-device dynamically ---
let radio_5g = null;
let radio_2g = null;
uci.foreach('wireless', 'wifi-device', (s) => {
	if (s.band == '5g') radio_5g ??= s['.name'];
	if (s.band == '2g') radio_2g ??= s['.name'];
});

const COUNTRIES = [
	['00', 'World (default, restricted)'],
	['US', 'United States'],
	['CA', 'Canada'],
	['GB', 'United Kingdom'],
	['DE', 'Germany'],
	['FR', 'France'],
	['NL', 'Netherlands'],
	['SE', 'Sweden'],
	['AU', 'Australia'],
	['NZ', 'New Zealand'],
	['JP', 'Japan']
];

const CHANNELS_5G = ['36','40','44','48','149','153','157','161','165'];
const CHANNELS_2G = ['1','6','11'];

// Channel widths. Default (HE80 on 5 GHz, HE20 on 2.4 GHz) matches what
// ath11k auto-picks, which is great for throughput but mediocre for
// MANET range/resilience. Operators who want longer reach typically
// drop to HE20 or HE40.
const HTMODES_5G = ['HE20','HE40','HE80','HE160'];
const HTMODES_2G = ['HE20','HE40'];

// --- Handle POST submission ---
let posted = http.getenv('REQUEST_METHOD') == 'POST';
let msg = null;

if (posted) {
	let mesh_id        = http.formvalue('mesh_id')        || 'openmanet-mesh';
	let channel        = http.formvalue('channel')        || '36';
	let encryption     = http.formvalue('encryption')     || 'none';
	let key            = http.formvalue('key')            || '';
	let country        = http.formvalue('country')        || '00';
	let mesh_2g_enable = http.formvalue('mesh_2g_enable') == '1';
	let channel_2g     = http.formvalue('channel_2g')     || '6';
	let htmode_5g      = http.formvalue('htmode_5g')      || 'HE80';
	let htmode_2g      = http.formvalue('htmode_2g')      || 'HE20';

	if (!radio_5g) {
		msg = 'No 5 GHz wifi-device found in /etc/config/wireless — cannot configure mesh.';
	} else {
		// --- network.bat0 (batman-adv soft-iface) -----------------------
		// Pure L2 by default — no IP assignment. User can bridge into LAN
		// or set a static IP via Network → Interfaces afterward. We avoid
		// touching network.lan here to eliminate lockout risk.
		//
		// Idempotent: create the section type only when missing, but
		// always overwrite the option values. A previous install can
		// leave a stub bat0 section with stray fields (kmod-batman-adv's
		// default state seeds multicast_mode), so guarding all the
		// options behind `if (!uci.get(...))` would skip the real config.
		if (!uci.get('network', 'bat0'))
			uci.set('network', 'bat0', 'interface');
		uci.set('network', 'bat0', 'proto',           'batadv');
		uci.set('network', 'bat0', 'routing_algo',    'BATMAN_V');
		uci.set('network', 'bat0', 'aggregated_ogms', '1');
		uci.set('network', 'bat0', 'gw_mode',         'off');
		// Note on multicast_mode: kmod-batman-adv defaults this to '0'
		// (multicast snooping OFF → batman-adv floods multicast as
		// broadcast). For ATAK CoT-over-mesh that's actually the safer
		// choice: every peer receives every position broadcast without
		// needing well-behaved IGMP/MLD reports from clients. netifd
		// also re-asserts the '0' default on every `network reload`, so
		// trying to override here is a losing battle. Left alone
		// intentionally.

		// --- network.mesh (batman-adv hard-iface; binds wifi to bat0) ---
		if (!uci.get('network', 'mesh'))
			uci.set('network', 'mesh', 'interface');
		uci.set('network', 'mesh', 'proto',  'batadv_hardif');
		uci.set('network', 'mesh', 'master', 'bat0');

		// --- wireless.mesh0 (the 802.11s wifi-iface on the 5 GHz radio) -
		if (!uci.get('wireless', 'mesh0')) {
			uci.set('wireless', 'mesh0', 'wifi-iface');
		}
		uci.set('wireless', 'mesh0', 'device',     radio_5g);
		uci.set('wireless', 'mesh0', 'network',    'mesh');
		uci.set('wireless', 'mesh0', 'mode',       'mesh');
		uci.set('wireless', 'mesh0', 'disabled',   '0');
		uci.set('wireless', 'mesh0', 'mesh_id',    mesh_id);
		uci.set('wireless', 'mesh0', 'encryption', encryption);
		if (encryption == 'sae' && length(key) >= 8)
			uci.set('wireless', 'mesh0', 'key', key);
		else
			uci.delete('wireless', 'mesh0', 'key');

		// --- Radio settings — channel, country, and enable the radio ---
		// Stock OpenWrt ships radios with disabled=1; mesh needs them on.
		uci.set('wireless', radio_5g, 'disabled', '0');
		uci.set('wireless', radio_5g, 'channel',  channel);
		uci.set('wireless', radio_5g, 'country',  country);
		uci.set('wireless', radio_5g, 'htmode',   htmode_5g);
		if (radio_2g) {
			uci.set('wireless', radio_2g, 'country', country);
			uci.set('wireless', radio_2g, 'htmode',  htmode_2g);
		}

		// --- Optional: 2.4 GHz mesh on the second radio --------------
		// Creates a parallel mesh interface (wireless.mesh1) on the
		// 2.4 GHz radio with the SAME mesh_id + encryption as the 5 GHz
		// side, but a different channel. Both wifi-ifaces are bound to
		// bat0 via batadv_hardif, so batman-adv bridges traffic between
		// bands at L2 — a peer joining on either band sees every other
		// peer regardless of which band that peer is on.
		//
		// Coexists with the 2.4 GHz mgmt AP: ath11k supports AP + mesh
		// VAPs on the same radio, sharing the channel. Setting
		// channel_2g here also moves the mgmt AP to that channel
		// (single radio = single channel constraint).
		if (radio_2g && mesh_2g_enable) {
			uci.set('wireless', radio_2g, 'disabled', '0');
			uci.set('wireless', radio_2g, 'channel',  channel_2g);

			if (!uci.get('wireless', 'mesh1'))
				uci.set('wireless', 'mesh1', 'wifi-iface');
			uci.set('wireless', 'mesh1', 'device',     radio_2g);
			uci.set('wireless', 'mesh1', 'network',    'mesh_2g');
			uci.set('wireless', 'mesh1', 'mode',       'mesh');
			uci.set('wireless', 'mesh1', 'disabled',   '0');
			uci.set('wireless', 'mesh1', 'mesh_id',    mesh_id);
			uci.set('wireless', 'mesh1', 'encryption', encryption);
			if (encryption == 'sae' && length(key) >= 8)
				uci.set('wireless', 'mesh1', 'key', key);
			else
				uci.delete('wireless', 'mesh1', 'key');

			if (!uci.get('network', 'mesh_2g'))
				uci.set('network', 'mesh_2g', 'interface');
			uci.set('network', 'mesh_2g', 'proto',  'batadv_hardif');
			uci.set('network', 'mesh_2g', 'master', 'bat0');
		} else if (radio_2g) {
			// 2.4 GHz mesh opt-out: tear down mesh1 cleanly. mgmt AP on
			// radio_2g (wireless.mgmt_ap, laid down by uci-defaults)
			// stays untouched.
			if (uci.get('wireless', 'mesh1'))
				uci.set('wireless', 'mesh1', 'disabled', '1');
			if (uci.get('network', 'mesh_2g'))
				uci.delete('network', 'mesh_2g');
		}

		// --- bat0 L3 (optional) — assign a static IP to the mesh ------
		// network.bat0 owns proto=batadv (creates the bat0 netdev). To put
		// L3 on top, we use a SECOND interface section that targets bat0
		// as its device. Keeps the proto=batadv config clean and avoids
		// netifd confusion.
		let bat_ip      = http.formvalue('bat_ip')      || '';
		let bat_netmask = http.formvalue('bat_netmask') || '255.255.0.0';

		if (length(bat_ip) >= 7) {
			if (!uci.get('network', 'bat0_ip'))
				uci.set('network', 'bat0_ip', 'interface');
			uci.set('network', 'bat0_ip', 'device',  'bat0');
			uci.set('network', 'bat0_ip', 'proto',   'static');
			uci.set('network', 'bat0_ip', 'ipaddr',  bat_ip);
			uci.set('network', 'bat0_ip', 'netmask', bat_netmask);
		} else if (uci.get('network', 'bat0_ip')) {
			// Operator cleared the field — opt out of L3 entirely.
			uci.delete('network', 'bat0_ip');
		}

		// --- alfred — point its batman gossip side at bat0 -------------
		// The alfred package ships /etc/config/alfred with `list interface
		// 'br-ahwlan'` because it's designed for OpenMANET's HaLow boards
		// (which have a HaLow LAN bridge). On AXT-1800 there is no
		// br-ahwlan, so alfred spins forever logging "can't get interface".
		// Overwrite to bat0 here so the wizard fully provisions the stack.
		if (uci.get('alfred', 'alfred')) {
			uci.set('alfred', 'alfred', 'interface', ['bat0']);
			uci.set('alfred', 'alfred', 'batmanif',  'bat0');
			uci.commit('alfred');
		}

		uci.commit('wireless');
		uci.commit('network');

		// Reload everything non-blocking so the HTTP response goes out
		// first. wifi reload picks up wireless.mesh0, network reload
		// picks up bat0/mesh, alfred restart picks up the new -i bat0.
		// The [ -x ] guards make this safe even if alfred isn't installed.
		popen('(sleep 1 && /etc/init.d/network reload && wifi reload && [ -x /etc/init.d/alfred ] && /etc/init.d/alfred restart) &', 'r');
		msg = 'Saved. Wireless, batman-adv, and alfred reloading…';
	}
}

// --- Read current values for rendering ---
const cur_mesh_id     = uci.get('wireless', 'mesh0', 'mesh_id')     || 'openmanet-mesh';
const cur_encryption  = uci.get('wireless', 'mesh0', 'encryption')  || 'none';
const cur_key         = uci.get('wireless', 'mesh0', 'key')         || '';
const cur_channel     = (radio_5g && uci.get('wireless', radio_5g, 'channel')) || '36';
const cur_country     = (radio_5g && uci.get('wireless', radio_5g, 'country')) || '00';
const cur_bat_ip      = uci.get('network', 'bat0_ip', 'ipaddr')     || '';
const cur_bat_netmask = uci.get('network', 'bat0_ip', 'netmask')    || '255.255.0.0';
// 2.4 GHz mesh state: present + not explicitly disabled
const cur_mesh_2g_enable =
	uci.get('wireless', 'mesh1') &&
	uci.get('wireless', 'mesh1', 'disabled') != '1';
const cur_channel_2g  = (radio_2g && uci.get('wireless', radio_2g, 'channel')) || '6';
const cur_htmode_5g   = (radio_5g && uci.get('wireless', radio_5g, 'htmode'))  || 'HE80';
const cur_htmode_2g   = (radio_2g && uci.get('wireless', radio_2g, 'htmode'))  || 'HE20';

include('header');
%}

<h2>{{ _('AXT-1800 Mesh Wizard') }}</h2>

<p>{{ _('Configure the 802.11s mesh on the 5 GHz radio. Other nodes joining must use the same Mesh ID, channel, and encryption key.') }}</p>

{% if (msg): %}
<div style="background:#2d6a4f;color:#fff;padding:10px;border-radius:6px;margin-bottom:1em;">
	{{ msg }}
</div>
{% endif %}

<form method="POST" action="" style="max-width:640px;">
	<fieldset>
		<legend>{{ _('Mesh') }}</legend>

		<p>
			<label><b>{{ _('Mesh ID') }}</b></label><br>
			<input type="text" name="mesh_id" value="{{ cur_mesh_id }}" required style="width:100%;padding:6px;">
			<small>{{ _('Must match on every node. Treated as a network identifier, not a secret.') }}</small>
		</p>

		<p>
			<label><b>{{ _('5 GHz Channel') }}</b></label><br>
			<select name="channel" style="width:100%;padding:6px;">
			{% for (ch in CHANNELS_5G): %}
				<option value="{{ ch }}"{{ ch == cur_channel ? ' selected' : '' }}>{{ ch }}</option>
			{% endfor %}
			</select>
			<small>{{ _('Non-DFS channels are 36/40/44/48 and 149-165 — no radar-wait on bring-up.') }}</small>
		</p>

		<p>
			<label><b>{{ _('5 GHz Channel Width') }}</b></label><br>
			<select name="htmode_5g" style="width:100%;padding:6px;">
			{% for (m in HTMODES_5G): %}
				<option value="{{ m }}"{{ m == cur_htmode_5g ? ' selected' : '' }}>{{ m }}</option>
			{% endfor %}
			</select>
			<small>{{ _('HE20=20MHz, HE40=40MHz, HE80=80MHz, HE160=160MHz. Wider = more throughput but shorter range and harder to fit in crowded RF. HE20 or HE40 is recommended for outdoor MANET range; HE80 is the ath11k default and best for indoor / dense mesh. HE80 requires consecutive channels (ch 36 / 52 / 100 / 116 / 132 / 149 are valid primaries; 161 and 165 do not work at HE80).') }}</small>
		</p>

		<p>
			<label><b>{{ _('Encryption') }}</b></label><br>
			<select name="encryption" style="width:100%;padding:6px;">
				<option value="none"{{ cur_encryption == 'none' ? ' selected' : '' }}>{{ _('None (open mesh)') }}</option>
				<option value="sae"{{ cur_encryption == 'sae' ? ' selected' : '' }}>{{ _('SAE (WPA3)') }}</option>
			</select>
		</p>

		<p>
			<label><b>{{ _('Passphrase (if SAE)') }}</b></label><br>
			<input type="password" name="key" value="{{ cur_key }}" minlength="8" maxlength="63" style="width:100%;padding:6px;">
			<small>{{ _('8–63 characters. Must match on all peers.') }}</small>
		</p>
	</fieldset>

	<fieldset>
		<legend>{{ _('Optional: 2.4 GHz mesh radio') }}</legend>

		<p>
			<label>
				<input type="checkbox" name="mesh_2g_enable" value="1"{{ cur_mesh_2g_enable ? ' checked' : '' }}>
				<b>{{ _('Also bring up the 2.4 GHz radio as a mesh point') }}</b>
			</label><br>
			<small>{{ _('When enabled, the 2.4 GHz radio joins the same mesh (same ID + encryption as 5 GHz) on the channel below. batman-adv bridges traffic between bands, so peers on either band see each other. Slower than 5 GHz, but better range and wall penetration. The 2.4 GHz management AP keeps working on the same channel.') }}</small>
		</p>

		<p>
			<label><b>{{ _('2.4 GHz Channel') }}</b></label><br>
			<select name="channel_2g" style="width:100%;padding:6px;">
			{% for (ch in CHANNELS_2G): %}
				<option value="{{ ch }}"{{ ch == cur_channel_2g ? ' selected' : '' }}>{{ ch }}</option>
			{% endfor %}
			</select>
			<small>{{ _('Channels 1, 6, and 11 are non-overlapping in most regions. The 2.4 GHz management AP runs on this same channel (single-radio, single-channel constraint).') }}</small>
		</p>

		<p>
			<label><b>{{ _('2.4 GHz Channel Width') }}</b></label><br>
			<select name="htmode_2g" style="width:100%;padding:6px;">
			{% for (m in HTMODES_2G): %}
				<option value="{{ m }}"{{ m == cur_htmode_2g ? ' selected' : '' }}>{{ m }}</option>
			{% endfor %}
			</select>
			<small>{{ _('HE20=20MHz, HE40=40MHz. HE20 is strongly recommended in 2.4 GHz — HE40 overlaps with 5 of the 11 channels and is unfriendly in any populated environment. Applies to both mesh and mgmt-AP on this radio.') }}</small>
		</p>
	</fieldset>

	<fieldset>
		<legend>{{ _('Mesh L3 (optional)') }}</legend>

		<p>
			<label><b>{{ _('Node IP on bat0') }}</b></label><br>
			<input type="text" name="bat_ip" value="{{ cur_bat_ip }}" placeholder="10.41.1.1" style="width:100%;padding:6px;">
			<small>{{ _('Leave blank for L2-only mesh. To carry traffic over the mesh, give every node a unique IP in the same /16 subnet (e.g. 10.41.1.1, 10.41.1.2, …).') }}</small>
		</p>

		<p>
			<label><b>{{ _('Netmask') }}</b></label><br>
			<input type="text" name="bat_netmask" value="{{ cur_bat_netmask }}" placeholder="255.255.0.0" style="width:100%;padding:6px;">
			<small>{{ _('Defaults to /16 (255.255.0.0) so up to ~65k mesh nodes fit.') }}</small>
		</p>
	</fieldset>

	<fieldset>
		<legend>{{ _('Regulatory') }}</legend>
		<p>
			<label><b>{{ _('Country Code') }}</b></label><br>
			<select name="country" style="width:100%;padding:6px;">
			{% for (c in COUNTRIES): %}
				<option value="{{ c[0] }}"{{ c[0] == cur_country ? ' selected' : '' }}>{{ c[1] }}</option>
			{% endfor %}
			</select>
			<small>{{ _('Applied to both radios. Required for full TX power and to unlock regional channels.') }}</small>
		</p>
	</fieldset>

	<p>
		<button type="submit" class="btn cbi-button cbi-button-apply" style="padding:8px 16px;">
			{{ _('Save & Apply') }}
		</button>
	</p>
</form>

{% include('footer'); %}
