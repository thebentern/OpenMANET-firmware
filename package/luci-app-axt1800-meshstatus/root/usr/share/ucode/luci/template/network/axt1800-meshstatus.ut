{%
//
// AXT-1800 mesh status dashboard, server-side rendered.
//
// Read-only operator view of the 802.11s + batman-adv + alfred + openmanetd
// stack. Answers "who can I reach on this mesh, and how well?" — the question
// the wizard doesn't address once configuration is past.
//
// Data sources (all already in the image; verified pre-build):
//   - batctl meshif bat0 originators / statistics / gw_mode / gateways
//   - iw dev phy0-mesh0 info / station dump
//   - /etc/bat-hosts (auto-maintained by alfred; MAC → hostname map)
//   - /sys/class/net/{bat0,phy0-mesh0}/statistics/*
//   - pidof + logread for service-up indicators and recent activity
//
// alfred-json is NOT installed on this image (probed 2026-05-18) so we do
// MAC→hostname lookups via /etc/bat-hosts directly. That file is regenerated
// by alfred every 5 minutes — stale data here is operator-visible.
//

import { popen, readfile, lsdir } from 'fs';

const MESH_IF = 'phy0-mesh0';
const BAT_IF  = 'bat0';

// --- helpers ---------------------------------------------------------------

function slurp(cmd) {
	let fp = popen(cmd, 'r');
	if (!fp) return '';
	let out = fp.read('all') || '';
	fp.close();
	return trim(out);
}

function service_pids() {
	return {
		alfred:     slurp('pidof alfred')     != '',
		openmanetd: slurp('pidof openmanetd') != '',
		batadv:     readfile('/sys/class/net/' + BAT_IF + '/operstate') != null
	};
}

// Parse /etc/bat-hosts into a {MAC: hostname} dict. The file's format is
// `MAC hostname`, with `#` comments. alfred regenerates this every 5 min.
function load_bat_hosts() {
	let txt = readfile('/etc/bat-hosts');
	let map = {};
	if (!txt) return map;
	for (let line in split(txt, '\n')) {
		line = trim(line);
		if (length(line) == 0 || substr(line, 0, 1) == '#') continue;
		let m = match(line, /^([0-9A-Fa-f:]+)\s+(\S+)/);
		if (m) map[lc(m[1])] = m[2];
	}
	return map;
}

// Parse batctl originators output. Format:
//   [B.A.T.M.A.N. adv ...]              <- header, skip
//      Originator   last-seen ... Nexthop [iface]
//   [data rows below]
function parse_originators() {
	let raw = slurp('batctl meshif ' + BAT_IF + ' originators 2>/dev/null');
	let lines = split(raw, '\n');
	let rows = [];
	let header_seen = false;
	for (let line in lines) {
		// Skip the leading [B.A.T.M.A.N. adv ...] banner
		if (substr(line, 0, 1) == '[') continue;
		// Skip the column header line — it starts with whitespace then "Originator"
		if (!header_seen && index(line, 'Originator') >= 0) {
			header_seen = true;
			continue;
		}
		// Split on whitespace
		let parts = split(trim(line), /\s+/);
		if (length(parts) < 4) continue;
		push(rows, {
			originator: lc(parts[0]),
			lastseen:   parts[1],
			throughput: parts[3] || '',  // batctl prints "(  4.5 MBit)" multi-word; rough
			nexthop:    parts[length(parts) - 2] || '',
			iface:      replace(parts[length(parts) - 1] || '', /[\[\]]/g, '')
		});
	}
	return rows;
}

// Parse iw station dump. Format is multi-line per station; we extract:
//   Station <MAC> (on <iface>)
//       <key>: <value>
function parse_stations() {
	let raw = slurp('iw dev ' + MESH_IF + ' station dump 2>/dev/null');
	let stations = [];
	let cur = null;
	for (let line in split(raw, '\n')) {
		let m = match(line, /^Station\s+([0-9A-Fa-f:]+)/);
		if (m) {
			if (cur) push(stations, cur);
			cur = { mac: lc(m[1]), signal: '', tx_rate: '', rx_rate: '', tx_failed: '' };
			continue;
		}
		if (!cur) continue;
		let mm;
		mm = match(line, /^\s*signal:\s*(-?\d+(?:\.\d+)?)\s*\[?/);
		if (mm) cur.signal = mm[1];
		mm = match(line, /^\s*tx bitrate:\s*([\d.]+)\s*MBit\/s/);
		if (mm) cur.tx_rate = mm[1];
		mm = match(line, /^\s*rx bitrate:\s*([\d.]+)\s*MBit\/s/);
		if (mm) cur.rx_rate = mm[1];
		mm = match(line, /^\s*tx failed:\s*(\d+)/);
		if (mm) cur.tx_failed = mm[1];
	}
	if (cur) push(stations, cur);
	// Sort by signal descending (strongest first). Empty signal sorts last.
	return sort(stations, function(a, b) {
		let aa = a.signal == '' ?  -999 : +a.signal;
		let bb = b.signal == '' ?  -999 : +b.signal;
		return aa < bb ? 1 : -1;
	});
}

// Parse batctl statistics into key→value dict for display
function parse_stats() {
	let raw = slurp('batctl meshif ' + BAT_IF + ' statistics 2>/dev/null');
	let out = {};
	for (let line in split(raw, '\n')) {
		let m = match(line, /^\s*(\S+):\s*(\d+)/);
		if (m) out[m[1]] = m[2];
	}
	return out;
}

// Parse `iw dev <if> info` into key→value for display. Multi-word values are fine.
function parse_iw_info() {
	let raw = slurp('iw dev ' + MESH_IF + ' info 2>/dev/null');
	let out = {};
	for (let line in split(raw, '\n')) {
		let m = match(line, /^\s+(\w[\w\s]*?):\s*(.+)$/);
		if (m) out[trim(m[1])] = trim(m[2]);
	}
	// Channel line has a special shape: "channel 36 (5180 MHz), width: 80 MHz, ..."
	let cm = match(raw, /channel\s+(\d+)\s+\(\s*(\d+)\s*MHz\),\s*width:\s*(\d+)/);
	if (cm) {
		out['channel']   = cm[1];
		out['frequency'] = cm[2] + ' MHz';
		out['width']     = cm[3] + ' MHz';
	}
	let mm = match(raw, /type\s+(\S+)/);
	if (mm) out['type'] = mm[1];
	return out;
}

function format_bytes(n) {
	if (!n || n == 0) return '0';
	n = +n;
	if (n < 1024) return n + ' B';
	if (n < 1024*1024) return sprintf('%.1f KB', n / 1024);
	if (n < 1024*1024*1024) return sprintf('%.1f MB', n / (1024*1024));
	return sprintf('%.1f GB', n / (1024*1024*1024));
}

// --- gather state ----------------------------------------------------------
const svc          = service_pids();
const bat_hosts    = load_bat_hosts();
const originators  = parse_originators();
const stations     = parse_stations();
const stats        = parse_stats();
const iw_info      = parse_iw_info();
const gw_mode      = slurp('batctl meshif ' + BAT_IF + ' gw_mode 2>/dev/null');
const log_lines    = split(slurp("logread 2>/dev/null | grep -iE 'batman|alfred|mesh0|openmanetd' | tail -20"), '\n');
const mc_bat       = readfile('/sys/class/net/' + BAT_IF      + '/statistics/multicast') || '0';
const mc_mesh      = readfile('/sys/class/net/' + MESH_IF + '/statistics/multicast') || '0';

include('header');
%}

<style>
	.ms-card       { background:#1c1c1c; border-radius:8px; padding:14px; margin-bottom:1em; }
	.ms-pill       { display:inline-block; padding:2px 10px; border-radius:11px; font-size:11px;
	                  font-weight:600; letter-spacing:0.5px; }
	.ms-pill-on    { background:#2d6a4f; color:#fff; }
	.ms-pill-off   { background:#444;    color:#bbb; }
	.ms-pill-warn  { background:#bf6900; color:#fff; }
	.ms-grid       { display:grid; grid-template-columns:auto 1fr; gap:6px 14px; font-size:13px; }
	.ms-grid dt    { color:#bbb; }
	.ms-grid dd    { color:#fff; font-family:Menlo,Consolas,monospace; font-size:12.5px; margin:0; }
	.ms-log        { background:#0f0f0f; color:#ddd; padding:10px; border-radius:6px;
	                  font-family:Menlo,Consolas,monospace; font-size:11.5px;
	                  max-height:280px; overflow:auto; white-space:pre-wrap; }
	.ms-empty      { color:#888; font-style:italic; padding:18px; text-align:center; }
	.ms-tbl th     { text-align:left; padding:6px 8px; background:#222; color:#bbb; font-size:11.5px;
	                  font-weight:600; letter-spacing:0.5px; }
	.ms-tbl td     { padding:6px 8px; font-family:Menlo,Consolas,monospace; font-size:12px; }
	.ms-tbl tr+tr td { border-top:1px solid #2a2a2a; }
	.ms-sig-strong { color:#7cd07c; }
	.ms-sig-ok     { color:#ddc77c; }
	.ms-sig-weak   { color:#d07c7c; }
</style>

<div class="cbi-map">
	<h2 name="content">{{ _('Mesh status') }}</h2>
	<div class="cbi-map-descr">
		{{ _('Read-only diagnostic view of the 802.11s + batman-adv + alfred + openmanetd stack. "Who is on this mesh and how well can I reach them?" Reload the page to refresh — there is no auto-poll because batctl / iw are not cheap calls.') }}
		<form method="GET" action="" style="display:inline-block;margin-left:1em;">
			<button type="submit" class="cbi-button">{{ _('Refresh') }}</button>
		</form>
	</div>

	<!-- ============================================================ -->
	<!-- Section 1: Mesh fabric health                                  -->
	<!-- ============================================================ -->
	<fieldset class="cbi-section">
		<legend>{{ _('Fabric health') }}</legend>
		<div class="ms-card">
			<div style="margin-bottom:10px;">
				<strong>{{ _('Services:') }}</strong>
				{% if (svc.batadv): %}<span class="ms-pill ms-pill-on">batman-adv</span>{% endif %}
				{% if (!svc.batadv): %}<span class="ms-pill ms-pill-off">batman-adv</span>{% endif %}
				{% if (svc.alfred): %}<span class="ms-pill ms-pill-on">alfred ({{ slurp('pidof alfred') }})</span>{% endif %}
				{% if (!svc.alfred): %}<span class="ms-pill ms-pill-off">alfred down</span>{% endif %}
				{% if (svc.openmanetd): %}<span class="ms-pill ms-pill-on">openmanetd ({{ slurp('pidof openmanetd') }})</span>{% endif %}
				{% if (!svc.openmanetd): %}<span class="ms-pill ms-pill-off">openmanetd down</span>{% endif %}
			</div>
			<dl class="ms-grid">
				<dt>{{ _('Mesh radio') }}</dt>      <dd>{{ MESH_IF }}{% if (iw_info.type): %} <span style="color:#888;">({{ iw_info.type }})</span>{% endif %}</dd>
				<dt>{{ _('Channel / width') }}</dt> <dd>{{ iw_info.channel || '—' }} @ {{ iw_info.frequency || '—' }}, {{ iw_info.width || '—' }}</dd>
				<dt>{{ _('Local MAC') }}</dt>       <dd>{{ iw_info.addr || '—' }}</dd>
				<dt>{{ _('Batman algorithm') }}</dt><dd>BATMAN_V (batman-adv 2025.4)</dd>
				<dt>{{ _('Gateway mode') }}</dt>    <dd>{{ gw_mode || 'off' }}</dd>
				<dt>{{ _('TX / RX') }}</dt>         <dd>{{ format_bytes(stats.tx_bytes) }} / {{ format_bytes(stats.rx_bytes) }} <span style="color:#888;">({{ stats.tx || '0' }} / {{ stats.rx || '0' }} pkts)</span></dd>
				<dt>{{ _('Multicast bat0 / mesh') }}</dt> <dd>{{ trim(mc_bat) }} / {{ trim(mc_mesh) }} <span style="color:#888;">packets</span></dd>
				<dt>{{ _('Forwarded') }}</dt>       <dd>{{ format_bytes(stats.forward_bytes) }} <span style="color:#888;">({{ stats.forward || '0' }} pkts)</span></dd>
			</dl>
		</div>
	</fieldset>

	<!-- ============================================================ -->
	<!-- Section 2: Originators (peers reachable across mesh)           -->
	<!-- ============================================================ -->
	<fieldset class="cbi-section">
		<legend>{{ _('Mesh peers (originators)') }}</legend>
		<div class="cbi-section-descr">
			{{ _('Every batman-adv node visible across the mesh — directly or via multi-hop. Hostname comes from /etc/bat-hosts (auto-maintained by alfred every ~5 min). Throughput is the BATMAN_V transmit-quality estimate, NOT raw link speed.') }}
		</div>
		<div class="cbi-section-node">
			{% if (length(originators) == 0): %}
				<div class="ms-empty">
					{{ _('No mesh originators visible. Either this is a single-node deployment, or no other 802.11s peers are reachable on this radio. Bring up another node with the same Mesh ID / channel / encryption from the wizard, then refresh.') }}
				</div>
			{% endif %}
			{% if (length(originators) > 0): %}
				<table class="ms-tbl" style="width:100%;">
					<thead>
						<tr>
							<th>{{ _('Originator') }}</th>
							<th>{{ _('Hostname') }}</th>
							<th>{{ _('Last seen') }}</th>
							<th>{{ _('Throughput') }}</th>
							<th>{{ _('Next hop') }}</th>
							<th>{{ _('Iface') }}</th>
						</tr>
					</thead>
					<tbody>
					{% for (o in originators): %}
						<tr>
							<td>{{ o.originator }}</td>
							<td>{{ bat_hosts[o.originator] || '—' }}</td>
							<td>{{ o.lastseen }}</td>
							<td>{{ o.throughput }}</td>
							<td>{{ o.nexthop }}</td>
							<td>{{ o.iface }}</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			{% endif %}
		</div>
	</fieldset>

	<!-- ============================================================ -->
	<!-- Section 3: Direct RF neighbours (one-hop 802.11s peers)        -->
	<!-- ============================================================ -->
	<fieldset class="cbi-section">
		<legend>{{ _('Direct radio peers (one-hop, 802.11s)') }}</legend>
		<div class="cbi-section-descr">
			{{ _('Stations one wireless hop away on the mesh radio. Signal is in dBm — values worse than -75 mean a marginal link, worse than -85 won\'t carry video. These rows are the RF reality; the originators table above can show peers reachable via multiple hops.') }}
		</div>
		<div class="cbi-section-node">
			{% if (length(stations) == 0): %}
				<div class="ms-empty">{{ _('No direct radio peers. The mesh radio is up but nobody is in range or talking. Move closer, check channel/encryption matches, or look at the originators table for multi-hop reachability.') }}</div>
			{% endif %}
			{% if (length(stations) > 0): %}
				<table class="ms-tbl" style="width:100%;">
					<thead>
						<tr>
							<th>{{ _('MAC') }}</th>
							<th>{{ _('Hostname') }}</th>
							<th>{{ _('Signal') }}</th>
							<th>{{ _('TX bitrate') }}</th>
							<th>{{ _('RX bitrate') }}</th>
							<th>{{ _('TX failed') }}</th>
						</tr>
					</thead>
					<tbody>
					{% for (s in stations): %}
						{% let sig_class = s.signal == '' ? '' : (+s.signal >= -65 ? 'ms-sig-strong' : (+s.signal >= -80 ? 'ms-sig-ok' : 'ms-sig-weak')); %}
						<tr>
							<td>{{ s.mac }}</td>
							<td>{{ bat_hosts[s.mac] || '—' }}</td>
							<td class="{{ sig_class }}">{{ s.signal ? s.signal + ' dBm' : '—' }}</td>
							<td>{{ s.tx_rate ? s.tx_rate + ' Mbit/s' : '—' }}</td>
							<td>{{ s.rx_rate ? s.rx_rate + ' Mbit/s' : '—' }}</td>
							<td>{{ s.tx_failed || '0' }}</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			{% endif %}
		</div>
	</fieldset>

	<!-- ============================================================ -->
	<!-- Section 4: Recent activity                                     -->
	<!-- ============================================================ -->
	<fieldset class="cbi-section">
		<legend>{{ _('Recent activity') }}</legend>
		<div class="cbi-section-descr">
			{{ _('Last 20 log lines filtered to mesh-related sources (batman-adv, alfred, openmanetd, the mesh radio). For openmanetd errors that repeat every second, ignore the noise — the daemon is fine.') }}
		</div>
		<div class="cbi-section-node">
			{% if (length(log_lines) == 0 || (length(log_lines) == 1 && log_lines[0] == '')): %}
				<div class="ms-empty">{{ _('No matching log lines.') }}</div>
			{% endif %}
			{% if (length(log_lines) > 0 && !(length(log_lines) == 1 && log_lines[0] == '')): %}
				<div class="ms-log">{% for (l in log_lines): %}{{ l }}
{% endfor %}</div>
			{% endif %}
		</div>
	</fieldset>

</div>

{% include('footer'); %}
